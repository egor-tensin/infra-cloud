{{ ansible_managed | comment }}

logoutput: syslog

internal: {{ dante_iface_internal }} port = {{ dante_port }}
external: {{ dante_iface_external }}

socksmethod: none
clientmethod: none

user.privileged: proxy
user.unprivileged: nobody

client pass {
    from: {{ dante_allowed_ips }} to: 0.0.0.0/0
    log: error connect disconnect
}
client block {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: connect error
}
socks pass {
    from: {{ dante_allowed_ips }} to: 0.0.0.0/0
    log: error connect disconnect
}
socks block {
    from: 0.0.0.0/0 to: 0.0.0.0/0
    log: connect error
}
