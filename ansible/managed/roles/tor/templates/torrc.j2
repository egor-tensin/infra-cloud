{{ ansible_managed | comment }}

{% if tor_address_external is defined %}
Address {{ tor_address_external }}
{% endif %}

Log notice syslog

DataDirectory {{ tor_data_dir }}

ExitRelay 0

SocksPort {{ tor_address_internal }}:{{ tor_port_socks_proxy }}

ControlPort 0
DirPort {{ tor_port_dir }}
ORPort {{ tor_port_or }} IPv4Only

{% if tor_nickname is defined %}
Nickname {{ tor_nickname }}
{% endif %}
{% if tor_email is defined %}
ContactInfo {{ tor_email }}
{% endif %}

AccountingStart day 0:00
AccountingMax 150 GBytes
AccountingRule out

RelayBandwidthRate 2 MBytes
RelayBandwidthBurst 4 MBytes
